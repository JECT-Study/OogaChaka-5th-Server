# =====================================================================
# 로컬 실행용 설정 예제
# =====================================================================
# 사용법
#   1. 이 파일을 복사해 같은 폴더에 application-local.properties를 만든다.
#        cp src/main/resources/application-local.properties.example src/main/resources/application-local.properties
#   2. 복사한 파일의 REPLACE_... 값을 실제 값으로 바꾼다. (이 예제 파일은 수정하지 않는다)
#   3. IntelliJ 실행 설정의 Active profiles에 local을 넣는다.
#      (터미널이면 SPRING_PROFILES_ACTIVE=local ./gradlew bootRun)
#
# 이 파일의 동작 방식
#   - application-local.properties는 .gitignore 대상이라 Git에 올라가지 않는다.
#     그래서 아래 값은 모두 평문으로 적어도 된다. ENC(...)로 암호화할 필요가 없다.
#   - local 프로필로 실행하면 application.properties를 먼저 읽고 이 파일을 그 위에 덮어쓴다.
#     같은 키는 이 파일 값이 이기고, 이 파일에 없는 키는 application.properties 값을 그대로 쓴다.
#   - 이미 셸/IDE 환경변수(예: JASYPT_ENCRYPTOR_PASSWORD)가 있으면 그 환경변수가 이 파일보다 우선한다.
# =====================================================================

# ---------------------------------------------------------------------
# 1) 로컬 DB (필수)
# ---------------------------------------------------------------------
# 내 PC의 MySQL 정보를 평문으로 적는다. 공용 DB 주소를 넣지 않는다.
# (앱이 켜질 때 Flyway가 아직 병합되지 않은 마이그레이션까지 그 DB에 실행하기 때문)
spring.datasource.url=jdbc:mysql://localhost:3306/oogachaka
spring.datasource.username=REPLACE_WITH_LOCAL_DB_USERNAME
spring.datasource.password=REPLACE_WITH_LOCAL_DB_PASSWORD

# ---------------------------------------------------------------------
# 2) 암호화 키 4개 + Jasypt 비밀번호 (필수)
# ---------------------------------------------------------------------
# 값 만드는 법: 터미널에서 아래 명령을 "값마다 한 번씩" 실행하고, 출력된 한 줄을 그대로 붙여 넣는다.
#     openssl rand -base64 32
#   출력 예시(이 값을 쓰지 말 것): q3N8x1+Yb0kP2c6ZsV9tLmR4wE7hJdA5uFgTnXoKiQ8=
#   - 5개 모두 서로 다른 값이어야 한다. AES 키와 HMAC 키 2개가 같으면 앱이 시작되지 않는다.
#   - 따옴표로 감싸지 않는다. 앞뒤에 공백을 넣지 않는다.
#
# 팀이 같은 DB를 함께 쓰는 경우에는 아래 5개 값을 팀원 모두가 "똑같이" 써야 한다.
#   한 명이 한 번 만들어서 팀에 비공개로 공유한다(Git, 공개 채널 금지).
#   혼자 쓰는 로컬 DB라면 내가 만든 값을 써도 된다.
#
# 무엇에 쓰이나
#   aes-keys.v1              : DB에 저장하는 디바이스 토큰 원문을 AES-256-GCM으로 암호화/복호화
#   hmac-social-id-key       : 소셜 로그인 사용자 ID를 HMAC 해시로 바꿔 조회·중복 검사
#   hmac-device-token-key    : 디바이스 토큰을 HMAC 해시로 바꿔 조회·중복 검사(token_hash 컬럼)
#   jwt.secret               : 로그인 후 발급하는 JWT(access/refresh) 서명
#   jasypt.encryptor.password: application.properties에 적힌 ENC(...) 값을 풀 때 쓰는 비밀번호
#                              (application.properties에는 절대 적지 않는다. 적으면 시작이 실패한다)
app.crypto.aes-keys.v1=REPLACE_WITH_OPENSSL_RAND_BASE64_32
app.crypto.hmac-social-id-key=REPLACE_WITH_OPENSSL_RAND_BASE64_32
app.crypto.hmac-device-token-key=REPLACE_WITH_OPENSSL_RAND_BASE64_32
app.jwt.secret=REPLACE_WITH_OPENSSL_RAND_BASE64_32
jasypt.encryptor.password=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# ---------------------------------------------------------------------
# 3) Redis (인증 기능을 쓸 때)
# ---------------------------------------------------------------------
spring.data.redis.host=localhost
spring.data.redis.port=6379

# ---------------------------------------------------------------------
# 4) CORS (프런트 개발 서버 주소)
# ---------------------------------------------------------------------
app.cors.allowed-origins=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost

# ---------------------------------------------------------------------
# 5) 소셜 로그인 (선택, 사용할 제공자만 enabled=true)
# ---------------------------------------------------------------------
# 각 제공자 개발자 콘솔에서 발급받은 값을 평문으로 적는다.
# redirect-uri는 콘솔에 등록한 주소와 글자 하나까지 같아야 한다.
# 쓰지 않는 제공자는 enabled=false 그대로 두면 나머지 값은 비워도 된다.
app.oauth.providers.google.enabled=false
app.oauth.providers.google.client-id=
app.oauth.providers.google.client-secret=
app.oauth.providers.google.redirect-uri=http://localhost:5173/auth/callback/google
app.oauth.providers.kakao.enabled=false
# 카카오 client-id는 "REST API 키"다.
app.oauth.providers.kakao.client-id=
app.oauth.providers.kakao.client-secret=
app.oauth.providers.kakao.redirect-uri=http://localhost:5173/auth/callback/kakao
app.oauth.providers.naver.enabled=false
app.oauth.providers.naver.client-id=
app.oauth.providers.naver.client-secret=
app.oauth.providers.naver.redirect-uri=http://localhost:5173/auth/callback/naver

# ---------------------------------------------------------------------
# 6) 푸시(FCM) (선택)
# ---------------------------------------------------------------------
# false면 Firebase 없이도 앱이 시작된다(푸시는 보내지 않음).
app.fcm.enabled=false
# 켤 때는 Firebase 서비스 계정 JSON 파일을 저장소 밖에 두고 절대경로를 적는다.
# app.fcm.project-id=
# app.fcm.service-account-path=/absolute/path/outside/repository/firebase-service-account.json
